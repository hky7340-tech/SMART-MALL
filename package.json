{
  "name": "smart-mall-ecosystem",
  "version": "1.0.0",
  "description": "Enterprise Smart Mall Ecosystem - Full-featured shopping mall management platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
