    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@9.8.0",
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "jspdf": "4.2.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "recharts": "^3.10.1",
    "swiper": "14.0.6",
    "zustand": "^5.0.14"
