{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "concurrency": "21",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "migrate": {
      "cache": false
    }
  }
}